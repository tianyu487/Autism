# 复制本文件为 .env 并填入你的密钥
# Copy this file to .env and fill in your key.

# Anthropic API 密钥(用于社交故事脚本生成)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# 可选:覆盖生成用的模型(默认 claude-opus-4-8)
# AUTISMCARE_MODEL=claude-opus-4-8

# ---- 配音后端(默认 edge,免费)----
# 想要更自然的配音,改用 Azure 语音(需在 Azure 门户创建“语音服务”资源拿 key):
# AUTISMCARE_TTS=azure
# AZURE_SPEECH_KEY=你的Azure语音密钥
# AZURE_SPEECH_REGION=eastasia          # 与你创建资源时选的区域一致(如 eastasia / southeastasia / eastus)
# AUTISMCARE_ZH_VOICE=zh-CN-XiaoxiaoNeural   # 可选:zh-CN-XiaoyiNeural 等
# AUTISMCARE_AZURE_STYLE=gentle         # 可选:gentle 温柔 / affectionate 亲切 / calm / cheerful
